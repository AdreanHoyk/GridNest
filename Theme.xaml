<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <SolidColorBrush x:Key="UiAccent" Color="#8AE5D5"/>
  <SolidColorBrush x:Key="UiMuted" Color="#99B3C6"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#141E2A"/><Setter Property="Foreground" Value="#EDF3F8"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#213142"/><Setter Property="Foreground" Value="#F1F6FA"/><Setter Property="CaretBrush" Value="#8AE5D5"/><Setter Property="BorderBrush" Value="#405469"/><Setter Property="Padding" Value="9,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#2B4051"/><Setter Property="Foreground" Value="#F0F5FA"/><Setter Property="Padding" Value="12,7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter><Setter Property="Foreground" Value="#E9F2F7"/><Setter Property="Margin" Value="0,6"/></Style>
  <Style TargetType="RadioButton"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter><Setter Property="Foreground" Value="#E9F2F7"/><Setter Property="Margin" Value="0,7"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#1C2A38"/><Setter Property="Foreground" Value="#EDF3F8"/><Setter Property="BorderBrush" Value="#354B5C"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#8AE5D5"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="26"><Border Height="4" CornerRadius="2" Background="#3B5265" VerticalAlignment="Center"/><p:Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"><p:Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Height="4" VerticalAlignment="Center" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border CornerRadius="2" Background="#8AE5D5"/></ControlTemplate></RepeatButton.Template></RepeatButton></p:Track.DecreaseRepeatButton><p:Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Fill="#8AE5D5" Stroke="#163032" StrokeThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></p:Track.Thumb><p:Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Height="4" VerticalAlignment="Center" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></p:Track.IncreaseRepeatButton></p:Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#182635"/><Setter Property="Foreground" Value="#EEF5FA"/><Setter Property="BorderBrush" Value="#405367"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border x:Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="#405367" Height="1" Margin="8,5"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Check" Text="✓" Foreground="#8AE5D5" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#31495B"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="Transparent" CornerRadius="5" Margin="1,2"><p:Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value}"><p:Track.DecreaseRepeatButton><RepeatButton Command="{x:Static p:ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></p:Track.DecreaseRepeatButton><p:Track.Thumb><Thumb Background="#638296" MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2.5,1" Opacity=".8"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Margin" Value="0,1"/><Setter TargetName="Handle" Property="Background" Value="#9BE4DA"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="#8AE5D5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></p:Track.Thumb><p:Track.IncreaseRepeatButton><RepeatButton Command="{x:Static p:ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></p:Track.IncreaseRepeatButton></p:Track></Border></ControlTemplate></Setter.Value></Setter></Style>
  <SolidColorBrush x:Key="SettingsSurface" Color="#182635"/>
  <SolidColorBrush x:Key="SettingsLine" Color="#405367"/>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="#213142"/>
    <Setter Property="Foreground" Value="#F1F6FA"/>
    <Setter Property="BorderBrush" Value="#405469"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="10,7,32,7"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Outline" CornerRadius="7" Background="#213142" BorderBrush="#405469" BorderThickness="1">
                    <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#8AE5D5" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#8AE5D5"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#8AE5D5"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            <Border x:Name="FocusOutline" CornerRadius="7" BorderBrush="Transparent" BorderThickness="1.5" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="#182635" BorderBrush="#405367" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}" Margin="0,3,0,0" TextElement.Foreground="#EEF5FA">
                <ScrollViewer MaxHeight="260" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusOutline" Property="BorderBrush" Value="#8AE5D5"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#EEF5FA"/>
    <Setter Property="Padding" Value="9,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#31495B"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2B4051"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
